[Unit]
Description=R2 Storage Platform instance __INSTANCE__ (self-hosted S3/R2 object storage)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__DIR__/backend
Environment=NODE_ENV=production
EnvironmentFile=__ENV__
ExecStartPre=/bin/sh -c 'cd __DIR__/backend && npx prisma db push'
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65536

# --- Sandboxing -----------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=__DIR__/backend __DATA__
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
