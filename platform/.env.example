# R2 Storage control plane (platform) environment
# Copy to .env and adjust. Development values shown; production requires the
# marked variables.

# SQLite database file for the platform DB (customers, instances, usage).
# Use an ABSOLUTE path: the Prisma CLI resolves relative `file:` URLs against
# the schema directory while the runtime client resolves them against cwd, so a
# relative path would silently split the DB in two.
DATABASE_URL="file:/var/lib/r2platform/platform.db"

# Your platform zone (bought + hosted on Cloudflare). Used in emails/links and
# the nginx host map. e.g. r2platform.com
PLATFORM_DOMAIN="r2platform.com"
PLATFORM_BASE_URL="http://localhost:3000"

# REQUIRED in production. Master key used to AES-256-GCM encrypt tenant admin
# secrets + initial access keys at rest. Keep it secret, never commit it.
# Generate: openssl rand -hex 32
PLATFORM_MASTER_KEY=""

# Cloudflare API token (zone-scoped, Custom Hostnames:Edit + SSL:Edit) and the
# platform zone id. Required for SSL-for-SaaS hostname registration.
# CF_API_TOKEN=""
# CF_ZONE_ID=""
# CF_FALLBACK_ORIGIN="origin.r2platform.com"

# SMTP for verification + welcome emails. If unset, signup auto-verifies (dev).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="no-reply@r2platform.com"
# SMTP_PASS=""
# SMTP_FROM="R2 Storage <no-reply@r2platform.com>"

# Operator account (login uses this email + the bcrypt hash of its password).
# Generate the hash with: npm run hashpw -- '<password>'
# NOTE: Next's env loader expands $VAR references, and bcrypt hashes contain
# many `$`. Escape every `$` with a backslash inside the double quotes, e.g.
#   OPERATOR_PASSWORD_HASH="\$2b\$12\$AbCd..."
# or the hash will be silently truncated and login will fail.
# OPERATOR_EMAIL="ops@r2platform.com"
# OPERATOR_PASSWORD_HASH=""

# Tenant containers
# R2_IMAGE="r2storage:latest"
# TENANT_STORAGE_BASE="/srv/r2storage/tenants"
# NGINX_MAP_FILE="/etc/nginx/r2storage-map.conf"
#   Leave NGINX_MAP_FILE EMPTY ("") to disable map writing (local dev); the
#   map file is only written when this points at a real path.
# NGINX_RELOAD=false   # true only where nginx is running (production)
# MAX_INSTANCES_PER_CUSTOMER=1
# MAX_ACTIVE_INSTANCES=50

# Metering
# METER_KEY=""
# METERING_INTERVAL_MS=3600000

# Stripe billing. Leave unset for metering-only mode: checkout/portal return
# 501 and the dashboard shows "billing coming soon". To enable:
#   1. Create the subscription products/prices on Stripe and put the Pro price
#      id here (and/or set stripePriceId in lib/plans.ts):
# STRIPE_PRICE_PRO="price_..."
#   2. API key (test_/sk_...):
# STRIPE_SECRET_KEY=""
#   3. `stripe listen --forward-to localhost:3000/api/billing/webhook` then copy
#      the webhook signing secret (whsec_...):
# STRIPE_WEBHOOK_SECRET=""

# NODE_ENV=production
