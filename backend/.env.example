# R2 Storage Backend environment configuration
# Copy to .env and adjust for your deployment.

# Server port and bind host
PORT=4000
# 0.0.0.0 is fine for local dev; use 127.0.0.1 in production and proxy via nginx.
HOST=0.0.0.0

# SQLite database file (relative to backend/ when running locally)
DATABASE_URL="file:./dev.db"

# Local VPS storage directory for object blobs (defaults to ./data_storage)
STORAGE_DIR="./data_storage"

# REQUIRED. Strong secret used to protect the admin dashboard/API.
# The dashboard asks for this value on first load. Never use the default in production.
ADMIN_SECRET="change-me-to-a-long-random-string"

# Base domain for subdomain-style bucket resolution (bucket.storage.example.com)
BASE_DOMAIN="localhost"

# Optional tuning (defaults shown). Rate limits are per-IP per-minute.
# ADMIN_SESSION_TTL_HOURS=24
# RATE_LIMIT_GLOBAL=300
# RATE_LIMIT_ADMIN=30
# RATE_LIMIT_S3=600
# LOG_RETENTION_DAYS=30

# Storage quota in bytes; 0 (default) = unlimited. Can be changed at runtime via
# PATCH /api/admin/quota (persisted in the DB). The SaaS control plane sets this
# to the customer's plan limit.
# STORAGE_QUOTA_BYTES=0

# Brute-force lockout for the admin login. Per-IP: after LOGIN_FAIL_THRESHOLD
# consecutive wrong secrets from one address, that address is refused for
# LOGIN_IP_COOLDOWN_SEC. Global: after LOGIN_GLOBAL_THRESHOLD total failures
# across all addresses, all logins are refused for LOGIN_GLOBAL_COOLDOWN_SEC
# (doubling on each re-trigger). A failed attempt also answers after a fixed
# LOGIN_FAILURE_DELAY_MS to slow guessing.
# LOGIN_FAIL_THRESHOLD=5
# LOGIN_IP_COOLDOWN_SEC=1800
# LOGIN_GLOBAL_THRESHOLD=15
# LOGIN_GLOBAL_COOLDOWN_SEC=300
# LOGIN_FAILURE_DELAY_MS=150

# Set NODE_ENV=production to make dashboard session cookies Secure (HTTPS-only).
# NODE_ENV=production
