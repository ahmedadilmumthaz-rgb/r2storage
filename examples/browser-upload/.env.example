# Copy to .env — values from the r2storage control panel (Access Keys).
# Endpoint MUST end in /s3. The bucket's corsOrigins must include the page origin
# you'll open (or *), or the browser PUT will be blocked by CORS.
R2_ENDPOINT=https://cdn.example.com/s3
R2_REGION=us-east-1
R2_ACCESS_KEY_ID=r2_...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=my-app-assets
PORT=3000
